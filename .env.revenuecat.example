# Set these six variables on the BunBlocks backend in Vercel.
# Use the internal RevenueCat app IDs (the app_id field on webhooks).
REVENUECAT_IOS_APP_ID=
REVENUECAT_IOS_PUBLIC_KEY=
REVENUECAT_ANDROID_APP_ID=
REVENUECAT_ANDROID_PUBLIC_KEY=

# Generate two independent secrets with openssl rand -hex 32.
# Set the same full Authorization value in the RevenueCat webhook settings.
REVENUECAT_WEBHOOK_AUTH="Bearer REPLACE_WITH_RANDOM_SECRET"
# Keep this value stable across deployments.
REVENUECAT_ID_SECRET=

# Optional. Enable only for an isolated, non-production backend.
# REVENUECAT_ALLOW_SANDBOX=1

# Optional. Set only while building native binaries for sandbox testing.
# VITE_NATIVE_API_ORIGIN=https://your-test-api.example.com

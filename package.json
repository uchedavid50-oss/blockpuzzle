{
  "name": "blockpuzzle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "par": "vite-node scripts/make-par.ts",
    "validate": "vite-node scripts/validate.ts",
    "levels": "vite-node scripts/make-levels.ts",
    "dev:api": "vite-node scripts/dev-api.ts",
    "build:native": "node scripts/configure-native-google.mjs && tsc --noEmit && vite build --mode native",
    "cap:sync": "npm run build:native && cap sync",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "check:mobile": "node scripts/check-mobile-build.mjs",
    "android:test": "cd android && ./gradlew :app:connectedDebugAndroidTest",
    "android:build:signed": "node scripts/android-signing.mjs build",
    "android:signing": "node scripts/android-signing.mjs fingerprints"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-social-login": "^8.7.11",
    "@neondatabase/serverless": "^1.2.0",
    "@revenuecat/purchases-capacitor": "^14.1.2"
  }
}
